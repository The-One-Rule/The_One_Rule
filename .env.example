# Modèle. Copier en .env.local pour le développement (ignoré par git), et
# reporter ces clés dans les variables d'environnement du projet Vercel.
#
# Ces trois-là sont lues par Vite À LA COMPILATION : les changer après un
# déploiement n'a aucun effet tant qu'on n'a pas redéployé.

# Serveur de salons WebSocket. Absent = bouton MULTIJOUEUR caché, le solo tourne
# normalement. En production TOUJOURS wss:// et jamais ws:// — une page https ne
# peut pas ouvrir une socket en clair, et le navigateur ne le dit pas clairement.
VITE_WS_URL=wss://the-one-rule-salons.fly.dev

# URL du collecteur. Vide ou absent = aucune mesure, aucun bandeau, aucun appel
# réseau. Sur Vercel, c'est la fonction du dépôt, donc un chemin relatif :
VITE_COLLECT_URL=/api/collect

# API du mode classé. Vide = bouton CLASSÉ masqué, le reste du jeu fonctionne.
# À LAISSER VIDE sur Vercel : api/ranked.ts garde son classement dans une Map en
# mémoire, qui repart de zéro à chaque démarrage à froid de la fonction. Un
# classement qui s'efface tout seul est pire que pas de classement.
VITE_RANKED_URL=
