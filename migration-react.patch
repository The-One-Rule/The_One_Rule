@@ -0,0 +1,20 @@
+/**
+ * Le point d'entrée du client : deux imports, et leur ORDRE est le contrat.
+ *
+ *  1. `monte` écrit le DOM de l'application dans `#app` (le balisage vit dans
+ *     `src/ui/`) ;
+ *  2. `main` s'y branche. Il lit les éléments par leur `id` dès son évaluation
+ *     (`$("cv")`, `$("home")`…) : il ne doit jamais s'exécuter avant le rendu.
+ *
+ * Des imports STATIQUES et non un `import()` dynamique, pour trois raisons : un
+ * module ES n'est évalué qu'une fois ses dépendances évaluées, DANS L'ORDRE
+ * où elles sont écrites ; le jeu reste dans le paquet que la page référence
+ * (`scripts/check-deploy.mjs` y cherche l'URL du collecteur et celle des salons,
+ * et ne lit que les `<script>` de la page) ; et le navigateur ne fait pas deux
+ * allers-retours en cascade pour charger l'entrée puis le jeu.
+ *
+ * Ne pas réordonner, et ne pas laisser un formateur ou un tri d'imports le
+ * faire : `tests/ui.test.ts` tient cet ordre.
+ */
+import "./monte";
+import "./main";
diff --git a/src/monte.tsx b/src/monte.tsx
new file mode 100644
index 0000000..3c63031
--- /dev/null
+++ b/src/monte.tsx
@@ -0,0 +1,21 @@
+import { flushSync } from "react-dom";
+import { createRoot } from "react-dom/client";
+import { Shell } from "./ui/Shell";
+
+/**
+ * Écrit le DOM de l'application dans `#app`, de façon SYNCHRONE : `flushSync`
+ * ne rend la main qu'une fois les éléments en place.
+ *
+ * Ce module n'exporte rien et n'existe que pour son effet. `entry.tsx` l'importe
+ * AVANT `main.ts`, et c'est l'ordre d'évaluation des modules ES qui garantit que
+ * le DOM existe quand `main.ts` le lit.
+ *
+ * Les composants de `src/ui/` sont STATIQUES (ni état, ni props qui changent) :
+ * React les rend une fois et ne les re-rend jamais, donc ne touche plus au DOM
+ * que `main.ts` pilote impérativement (classes `hidden`, `innerHTML`…). C'est ce
+ * qui rend la migration écran par écran possible — voir docs/adr/0010.
+ */
+const racine = document.getElementById("app");
+if (!racine) throw new Error("#app introuvable dans index.html");
+
+flushSync(() => createRoot(racine).render(<Shell />));
