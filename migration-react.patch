+              aria-label="Room code"
+              data-i18n-aria="aria.codeSalon"
+            />
+          </div>
+          <div className="joinmort hidden" id="joinMort" aria-hidden="true">
+            <i />
+            <i />
+            <i />
+            <i />
+          </div>
+          <p className="warn hidden" id="multiJoinErr" />
+          {/*
